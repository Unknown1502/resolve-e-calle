# ── Resolve-E ────────────────────────────────────────────────────────
# Copy to .env. Every value here has a working default except the
# CALL-E key, so the system runs end to end with no configuration.

APP_ENV=development
LOG_LEVEL=INFO
APP_SECRET=change-me-in-production

# Ports are high on purpose: 5432 and 5433 are usually already taken by
# a local PostgreSQL install. These match docker-compose.yml.
DATABASE_URL=postgresql+psycopg://resolvee:resolvee@localhost:55432/resolvee
REDIS_URL=redis://localhost:56379/0

# ── CALL-E ───────────────────────────────────────────────────────────
# Get a key at https://heycall-e.com. It is read by the backend only and
# never reaches the browser.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# THE SAFETY INTERLOCK.
# While false, Resolve-E uses a deterministic simulator and places no
# real phone calls. Every test and the whole seeded demo run this way.
# Set to true ONLY when you have a key and a number you are authorized
# to call.
CALLE_LIVE_CALLS=false

# Comma-separated E.164 allowlist. When set, a live batch containing any
# number not on this list falls back to the simulator instead of
# dialling. Strongly recommended while developing.
CALLE_ALLOWED_NUMBERS=

# Public HTTPS URL for terminal call events. Optional: without it,
# the reconciliation worker still finishes every call by polling
# CALL-E, so a laptop demo needs no tunnel.
CALLE_WEBHOOK_URL=

# ── disclosure ───────────────────────────────────────────────────────
# The company the agent says it is calling on behalf of. Spoken aloud on
# every call, so it must be real. Live dispatch is refused without it --
# an agent that cannot say who it represents should not be dialling.
BUYER_COMPANY=

# ── policy (deterministic; never model-chosen) ───────────────────────
MAX_ATTEMPTS=3
DELAY_THRESHOLD_HOURS=48
MIN_COMPLETION_CONFIDENCE=0.70
ENFORCE_QUIET_HOURS=false
